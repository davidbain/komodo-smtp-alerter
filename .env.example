# Copy to .env and fill in. Never commit .env.

# SMTP relay. Port 465 uses implicit TLS; any other port uses STARTTLS.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender must be allowed to send through your relay.
MAIL_FROM=komodo@example.com
# Comma-separated list.
MAIL_TO=ops@example.com

# Shared secret Komodo sends as ?token=... Generate with: openssl rand -hex 32
AUTH_TOKEN=

# Also email when an alert clears. Test alerts are always sent.
SEND_RESOLVED=false

# DEBUG also logs the raw JSON of every received alert.
LOG_LEVEL=INFO

# Docker network that Komodo Core is attached to.
KOMODO_NETWORK=komodo_default
